{
  "name": "earth-trend-detective-functions",
  "private": true,
  "version": "1.0.0",
  "main": "lib/functions/src/server.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "prisma generate && tsc -p tsconfig.test.json && node --test .test-lib/functions/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "sync:appeears": "npm run build && node lib/functions/src/scripts/sync-appeears-catalog.js",
    "seed:zones": "npm run build && node lib/functions/src/scripts/seed-zones.js",
    "migrate:deploy": "prisma migrate deploy",
    "start": "node lib/functions/src/server.js",
    "dev": "npm run build && node --env-file-if-exists=.env.local lib/functions/src/server.js",
    "ingest": "npm run build && node --env-file-if-exists=.env.local lib/functions/src/scripts/run-ingest.js"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "1.44.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase-admin": "14.5.1",
    "genkit": "1.44.0",
    "jstat": "1.9.6",
    "pg": "8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@turf/centroid": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "typescript": "^5.9.3"
  }
}
