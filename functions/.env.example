GCLOUD_PROJECT=earth-trend-detective
FUNCTIONS_REGION=us-central1
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
ENFORCE_APP_CHECK=false
MAX_INSTANCES=1
QUOTA_GLOBAL_DAILY=100
QUOTA_GLOBAL_INTERPRET_DAILY=1000
QUOTA_GLOBAL_SEARCH_DAILY=2000
QUOTA_INTERPRET_QUERY=100
QUOTA_METEOMATICS_SUGGESTIONS=10
QUOTA_SEARCH_LOCATIONS=100
# Creation quota is per user per UTC hour; other per-user quotas are daily.
QUOTA_CREATE_ANALYSIS=10
QUOTA_GET_ANALYSIS=1000
QUOTA_METEOMATICS_AVAILABILITY=30
QUOTA_METEOMATICS_EXECUTE=20
QUOTA_GIOVANNI_EXECUTE=20
CACHE_TTL_SECONDS=86400
CURRENT_WEATHER_ENABLED=true
# Production uses Secret Manager by default. Set false for local-only credentials.
# METEOMATICS_USE_SECRET_MANAGER=false
# Local-only credentials: put in ignored .env.local / .secret.local, never commit values.
# METEOMATICS_USERNAME=
# METEOMATICS_PASSWORD=
# NASA Earthdata Login for the Giovanni historical source (approve "NASA GES DISC DATA ARCHIVE" in your EDL profile).
# Production secrets: EARTHDATA_USERNAME and EARTHDATA_PASSWORD. Locally, EARTHDATA_TOKEN may replace them.
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# EARTHDATA_TOKEN=

# Balam multi-source ingestion (see src/datasources/README.md). Production reads these from Secret Manager.
# Local-only values: put them in ignored .env.local, never commit them.
# DATABASE_URL=       # pooled PostgreSQL URL, used at runtime
# DIRECT_URL=         # direct PostgreSQL URL, only for `prisma migrate` and `seed:zones`
# NASA AppEEARS signs in with the same Earthdata Login account as Giovanni, under its own secret names:
# EARTHDATA_USER=
# EARTHDATA_PASS=
# Optional overrides:
# BALAM_CORS_ORIGINS=https://earth-trend-detective.web.app,https://earth-trend-detective.firebaseapp.com
# BALAM_INGEST_SCHEDULE=15 0 * * *
