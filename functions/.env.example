GCLOUD_PROJECT=earth-trend-detective
# Port of the HTTP server. Render sets PORT itself.
# PORT=8787
# Path to the Google service account key (Firestore, Auth token verification, Vertex AI). Never commit the file.
# GOOGLE_APPLICATION_CREDENTIALS=
# Comma-separated web origins allowed to call the API. Defaults to the Firebase Hosting domains (plus localhost outside production).
# CORS_ORIGINS=https://earth-trend-detective.web.app,https://earth-trend-detective.firebaseapp.com
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
ENFORCE_APP_CHECK=false
QUOTA_GLOBAL_DAILY=100
QUOTA_GLOBAL_INTERPRET_DAILY=1000
QUOTA_GLOBAL_SEARCH_DAILY=2000
QUOTA_INTERPRET_QUERY=100
QUOTA_METEOMATICS_SUGGESTIONS=10
QUOTA_SEARCH_LOCATIONS=100
# Creation quota is per user per UTC hour; other per-user quotas are daily.
QUOTA_CREATE_ANALYSIS=10
QUOTA_GET_ANALYSIS=1000
QUOTA_METEOMATICS_AVAILABILITY=30
QUOTA_METEOMATICS_EXECUTE=20
QUOTA_GIOVANNI_EXECUTE=20
QUOTA_EARTHDATA_EXECUTE=60
CACHE_TTL_SECONDS=86400
CURRENT_WEATHER_ENABLED=true
# Credentials: secret environment variables on Render; locally, the ignored .env.local. Never commit values.
# METEOMATICS_USERNAME=
# METEOMATICS_PASSWORD=
# NASA Earthdata Login for the Giovanni historical source (approve "NASA GES DISC DATA ARCHIVE" in your EDL profile).
# EARTHDATA_TOKEN may replace the username and password for Giovanni.
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# EARTHDATA_TOKEN=

# Balam multi-source ingestion (see src/datasources/README.md). Same rule: Render secrets in production, ignored .env.local locally.
# DATABASE_URL=       # pooled PostgreSQL URL, used at runtime
# DIRECT_URL=         # direct PostgreSQL URL, only for `prisma migrate` and `seed:zones`
# NASA AppEEARS reuses EARTHDATA_USERNAME / EARTHDATA_PASSWORD above (same Earthdata Login account; a token is not enough).
