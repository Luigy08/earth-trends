GCLOUD_PROJECT=earth-trend-detective
FUNCTIONS_REGION=us-central1
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
ENFORCE_APP_CHECK=false
MAX_INSTANCES=1
QUOTA_GLOBAL_DAILY=100
QUOTA_GLOBAL_INTERPRET_DAILY=1000
QUOTA_GLOBAL_SEARCH_DAILY=2000
QUOTA_INTERPRET_QUERY=100
QUOTA_METEOMATICS_SUGGESTIONS=10
QUOTA_SEARCH_LOCATIONS=100
# Creation quota is per user per UTC hour; other per-user quotas are daily.
QUOTA_CREATE_ANALYSIS=10
QUOTA_GET_ANALYSIS=1000
QUOTA_METEOMATICS_AVAILABILITY=30
QUOTA_METEOMATICS_EXECUTE=20
CACHE_TTL_SECONDS=86400
CURRENT_WEATHER_ENABLED=true
# Production uses Secret Manager by default. Set false for local-only credentials.
# METEOMATICS_USE_SECRET_MANAGER=false
# Local-only credentials: put in ignored .env.local / .secret.local, never commit values.
# METEOMATICS_USERNAME=
# METEOMATICS_PASSWORD=
